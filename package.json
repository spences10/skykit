{
	"name": "skykit",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"start": "node ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test": "pnpm run test:ci && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"test:ci": "vp test --run"
	},
	"devDependencies": {
		"@atproto/api": "^0.29.4",
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/playpen-sans": "^5.2.9",
		"@fontsource-variable/victor-mono": "^5.2.8",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "5.0.5",
		"daisyui": "5.7.50",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"fathom-client": "^3.7.2",
		"playwright": "1.64.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"packageManager": "pnpm@12.15.0"
}
