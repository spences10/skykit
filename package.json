{
	"name": "skykit",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"start": "node ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && pnpm run check:guardrails && vp check --no-lint && vp lint --deny-warnings && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:guardrails": "node tools/checks/run.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test": "pnpm run test:ci && pnpm run test:e2e",
		"test:guardrails": "node --test tools/checks/*.test.ts",
		"test:e2e": "playwright test",
		"test:ci": "pnpm run test:guardrails && vp test --run"
	},
	"dependencies": {
		"@fontsource/manrope": "^5.3.0",
		"@resvg/resvg-js": "2.6.2"
	},
	"devDependencies": {
		"@atproto/api": "^0.31.0",
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/playpen-sans": "^5.2.9",
		"@fontsource-variable/victor-mono": "^5.2.8",
		"@lucide/svelte": "^1.66.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "5.1.0",
		"daisyui": "5.8.0",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"fathom-client": "^3.7.2",
		"playwright": "1.65.0",
		"svead": "0.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"valibot": "1.5.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vite-plus": "1.6.0",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"packageManager": "pnpm@12.18.0"
}
